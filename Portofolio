<script>
(function(){
  "use strict";

  /* ---------------- EDIT MODE ---------------- */
  var editToggle = document.getElementById('editToggle');
  var body = document.body;

  function setEditMode(on){
    body.classList.toggle('edit-mode', on);
    editToggle.textContent = on ? '✓ Selesai Edit' : '✎ Edit Konten';
    document.querySelectorAll('.editable').forEach(function(el){
      el.contentEditable = on ? 'true' : 'false';
    });
    document.querySelectorAll('[data-role="link"]').forEach(function(a){
      if(on){ a.addEventListener('click', preventNav); }
      else { a.removeEventListener('click', preventNav); }
    });
  }
  function preventNav(e){ e.preventDefault(); }

  editToggle.addEventListener('click', function(){
    setEditMode(!body.classList.contains('edit-mode'));
  });
  setEditMode(false);

  /* ---------------- LINK EDITING ---------------- */
  document.addEventListener('click', function(e){
    var btn = e.target.closest('.link-edit-btn');
    if(!btn) return;
    e.preventDefault();
    e.stopPropagation();
    var link = btn.closest('[data-role="link"]');
    var current = link.getAttribute('href') || '';
    var next = window.prompt('Masukkan URL / alamat tautan:', current === '#' ? '' : current);
    if(next !== null && next.trim() !== ''){
      link.setAttribute('href', next.trim());
    }
  });

  /* ---------------- SKILL PILLS ---------------- */
  document.querySelectorAll('.add-pill').forEach(function(btn){
    btn.addEventListener('click', function(){
      var target = document.getElementById(btn.dataset.target);
      var pill = document.createElement('span');
      pill.className = 'skill-pill';
      pill.innerHTML = '<span class="editable" contenteditable="true">Skill baru</span><span class="rm">×</span>';
      target.appendChild(pill);
      pill.querySelector('.editable').contentEditable = 'true';
      pill.querySelector('.editable').focus();
    });
  });
  document.addEventListener('click', function(e){
    var rm = e.target.closest('.rm');
    if(!rm) return;
    var pill = rm.closest('.skill-pill');
    if(pill) pill.remove();
  });

  /* ---------------- PROJECT CARDS ---------------- */
  var projectGrid = document.getElementById('projectGrid');
  var addProjectBtn = document.getElementById('addProjectBtn');

  function makeProjectCard(){
    var card = document.createElement('div');
    card.className = 'proj-card';
    card.innerHTML =
      '<div class="card-controls"><button class="btn small danger removeCard">× hapus</button></div>' +
      '<div class="proj-kicker editable" contenteditable="true">Kategori</div>' +
      '<h3 class="editable" contenteditable="true">Nama Proyek Baru</h3>' +
      '<p class="editable" contenteditable="true">Deskripsikan proyek Anda di sini.</p>' +
      '<div class="proj-tags"><span class="tag editable" contenteditable="true">Tag</span></div>' +
      '<div class="proj-footer">' +
        '<a href="#" class="proj-link" data-role="link">Lihat detail →</a>' +
        '<button class="btn small ghost link-edit-btn">🔗 atur tautan</button>' +
      '</div>';
    return card;
  }

  addProjectBtn.addEventListener('click', function(){
    var card = makeProjectCard();
    projectGrid.insertBefore(card, addProjectBtn);
  });

  document.addEventListener('click', function(e){
    var rm = e.target.closest('.removeCard');
    if(!rm) return;
    var card = rm.closest('.proj-card');
    if(card) card.remove();
  });

  /* ---------------- EXPORT AS STANDALONE HTML ---------------- */
  document.getElementById('exportBtn').addEventListener('click', function(){
    var wasEdit = body.classList.contains('edit-mode');
    setEditMode(false);
    var html = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    var blob = new Blob([html], {type:'text/html'});
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'portofolio-hanan-daniyar.html';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    if(wasEdit) setEditMode(true);
  });

  /* ---------------- LATTICE → NETWORK CANVAS ---------------- */
  var canvas = document.getElementById('latticeCanvas');
  var ctx = canvas.getContext('2d');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var nodes = [], edges = [], pulses = [];
  var w, h, spacing = 64;

  function resize(){
    var hero = canvas.parentElement;
    w = canvas.width = hero.offsetWidth;
    h = canvas.height = hero.offsetHeight;
    buildLattice();
  }

  function buildLattice(){
    nodes = [];
    edges = [];
    var cols = Math.ceil(w / spacing) + 2;
    var rows = Math.ceil(h / spacing) + 2;
    for(var r = 0; r < rows; r++){
      for(var c = 0; c < cols; c++){
        nodes.push({
          x: c * spacing,
          y: r * spacing,
          baseX: c * spacing,
          baseY: r * spacing,
          r: r, c: c,
          phase: Math.random() * Math.PI * 2
        });
      }
    }
    var idx = function(r,c){ return r * cols + c; };
    for(var r2 = 0; r2 < rows; r2++){
      for(var c2 = 0; c2 < cols; c2++){
        if(c2 < cols - 1) edges.push([idx(r2,c2), idx(r2,c2+1)]);
        if(r2 < rows - 1) edges.push([idx(r2,c2), idx(r2+1,c2)]);
      }
    }
    pulses = [];
    for(var i = 0; i < Math.min(10, edges.length); i++){
      spawnPulse();
    }
  }

  function spawnPulse(){
    var e = edges[Math.floor(Math.random() * edges.length)];
    pulses.push({ edge: e, t: 0, speed: 0.006 + Math.random() * 0.008 });
  }

  function draw(time){
    ctx.clearRect(0, 0, w, h);

    if(!reduceMotion){
      nodes.forEach(function(n){
        n.x = n.baseX + Math.sin(time * 0.0006 + n.phase) * 3;
        n.y = n.baseY + Math.cos(time * 0.0006 + n.phase) * 3;
      });
    }

    // bonds
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(200,138,74,0.16)';
    edges.forEach(function(e){
      var a = nodes[e[0]], b = nodes[e[1]];
      ctx.beginPath();
      ctx.moveTo(a.x, a.y);
      ctx.lineTo(b.x, b.y);
      ctx.stroke();
    });

    // nodes
    nodes.forEach(function(n){
      ctx.beginPath();
      ctx.arc(n.x, n.y, 1.6, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(237,235,230,0.35)';
      ctx.fill();
    });

    // pulses (transactions traveling across the lattice)
    if(!reduceMotion){
      pulses.forEach(function(p){
        var a = nodes[p.edge[0]], b = nodes[p.edge[1]];
        var x = a.x + (b.x - a.x) * p.t;
        var y = a.y + (b.y - a.y) * p.t;
        var grad = ctx.createRadialGradient(x, y, 0, x, y, 5);
        grad.addColorStop(0, 'rgba(94,234,212,0.9)');
        grad.addColorStop(1, 'rgba(94,234,212,0)');
        ctx.beginPath();
        ctx.arc(x, y, 5, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        p.t += p.speed;
      });
      pulses = pulses.filter(function(p){ return p.t < 1; });
      if(Math.random() < 0.02) spawnPulse();
    }

    requestAnimationFrame(draw);
  }

  window.addEventListener('resize', resize);
  resize();
  requestAnimationFrame(draw);

})();
</script>
